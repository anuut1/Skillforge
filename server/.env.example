# ==============================================================================
# SKILLFORGE SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development

# Database (SQLite for local dev, PostgreSQL for RDS deployment)
# Local:
DATABASE_URL=file:./dev.db
# AWS RDS:
# DATABASE_URL=postgresql://skillforge_admin:<PASSWORD>@skillforge-db-prod.<REGION>.rds.amazonaws.com:5432/skillforge?schema=public

# Authentication Secrets
JWT_SECRET=replace-with-secure-random-string-in-production

# Amazon Cognito (Optional for local, required for AWS auth integration)
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=ap-south-1

# Amazon Web Services Configuration
AWS_REGION=ap-south-1

# S3 Buckets
S3_USER_DATA_BUCKET=skillforge-user-data-dev

# AI Provider: "local" (heuristic algorithms) or "bedrock" (Amazon Bedrock)
AI_PROVIDER=local
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1

# Asynchronous Pipelines
SQS_RESUME_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/skillforge-resume-processing-dev
EVENTBRIDGE_BUS_NAME=skillforge-events-dev
SNS_NOTIFICATION_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:skillforge-student-alerts-dev
